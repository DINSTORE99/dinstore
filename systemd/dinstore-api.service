[Unit]
Description=DINSTORE API
After=network.target
[Service]
Type=simple
WorkingDirectory=/opt/dinstore/api
EnvironmentFile=/etc/dinstore/config.env
ExecStart=/usr/bin/python3 /opt/dinstore/api/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/etc/dinstore /var/backups/dinstore /var/lib/dinstore
[Install]
WantedBy=multi-user.target
